    "retool",
    "mercury",
    "ramp",
    "ironclad",
    "persona",
    "watershed",
    "dbt-labs",
    "hex",
    "preset",
    "samsara",
    "databricks",
    "miro",
    "coda",
    "browserbase",
    "perplexity",
    "glean",
    "harvey",
    "typeface",
    "writer",
    "jasper",
    "copy-ai"
  ],
  "notes": "Template portal: loops over company_slugs. Each company using Greenhouse has a free public API at boards-api.greenhouse.io/v1/boards/<slug>/jobs?content=true. No auth needed. Add more slugs from crunchbase/wellfound funded companies."
