{
    "manifest_version": 3,
    "name": "LinkedIn Reply Automation",
    "version": "2.0.0",
    "description": "Automated LinkedIn comment replies with Google Sheets integration and Smart Engagement",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "https://www.linkedin.com/*",
        "http://127.0.0.1/*",
        "https://n8n.linkright.in/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "LinkedIn Reply Automation"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.linkedin.com/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "sidebar.css"
            ],
            "run_at": "document_idle"
        }
    ]
}